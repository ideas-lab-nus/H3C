# Copy this file to .env and provide credentials locally. Never commit .env.
H3C_MODEL_ENDPOINT=https://example.invalid/v1
H3C_MODEL_API_KEY=replace-with-local-secret
H3C_BOPTEST_ENDPOINT=http://127.0.0.1:5000

# Optional offline onboarding provider. The onboarding spec stores these names,
# never their values.
H3C_OFFLINE_MODEL_ENDPOINT=https://api.deepseek.com
H3C_OFFLINE_MODEL_API_KEY=replace-with-local-secret
H3C_OFFLINE_MODEL_ID=deepseek-chat
